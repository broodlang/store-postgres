;; End-to-end: the `store` repo + query-as-data driving the Postgres adaptor against
;; a real server. Requires PG (PG* env, default postgres/postgres @ 127.0.0.1:5432).
(defmodule repo-test
  (:use test)
  (:alias repo)
  (:alias query)
  (:alias pg)
  (:alias changeset)
  (:alias migration))

(defn opts ()
  {:host (or (os/env "PGHOST") "127.0.0.1")
   :port (string/->number (or (os/env "PGPORT") "5432"))
   :user (or (os/env "PGUSER") "postgres")
   :password (or (os/env "PGPASSWORD") "postgres")
   :database (or (os/env "PGDATABASE") "postgres")
   ;; size 1 so the temp table (session-scoped) is on the one connection we reuse
   :size 1})

(describe "repo over the pg adaptor (query-as-data → real Postgres)"
  :isolated (test "all returns rows as maps; where/order compile and run"
    (let (r (repo/open (pg/adaptor) (opts)))
      (repo/exec r "create temp table t (id int, name text, amount numeric)" [])
      (repo/exec r
        "insert into t values ($1,$2,$3),($4,$5,$6),($7,$8,$9)"
        [1 "ada" "9.99" 2 "grace" "100.50" 3 "alan" "0.01"])
      (let (rows (repo/all r
                   (-> (query/from :t)
                     (query/where [:> :id 1])
                     (query/order-by :id))))
        (is (= (count rows) 2))
        (is (= (get (first rows) :name) "grace"))
        (is (= (get (first rows) :id) 2))
        ;; numeric decodes to an exact decimal through the whole stack
        (is (= (get (first rows) :amount) 100.50M)))
      (let (one (repo/one r (-> (query/from :t) (query/where [:= :name "alan"]))))
        (is (= (get one :id) 3))
        (is (= (get one :amount) 0.01M)))
      ;; in / projection
      (let (names (repo/all r
                    (-> (query/from :t)
                      (query/select [:name])
                      (query/where [:in :id [1 3]])
                      (query/order-by :id))))
        (is (= (map names (fn (m) (get m :name))) (list "ada" "alan"))))
      (repo/close r)))

  (test "insert / update / delete via the repo (data-driven, RETURNING)"
    (let (r (repo/open (pg/adaptor) (opts)))
      (repo/exec r "create temp table w (id int, name text)" [])
      (is (= (get (repo/insert r :w {:id 1 :name "ada"}) :name) "ada"))
      (repo/insert r :w {:id 2 :name "grace"})
      (let (upd (repo/update r :w {:name "GRACE"} [:= :id 2]))
        (is (= (count upd) 1))
        (is (= (get (first upd) :name) "GRACE")))
      (is (= (count (repo/delete r :w [:= :id 1])) 1))
      (let (left (repo/all r (-> (query/from :w) (query/order-by :id))))
        (is (= (count left) 1))
        (is (= (get (first left) :name) "GRACE")))
      (repo/close r)))

  (test "transaction commits on success and rolls back on throw"
    (let (r (repo/open (pg/adaptor) (opts)))
      (repo/exec r "create temp table acct (id int, bal int)" [])
      (repo/insert r :acct {:id 1 :bal 100})
      ;; success → committed
      (repo/transaction r
        (fn (tx)
          (repo/update tx :acct {:bal 90} [:= :id 1])
          (repo/insert tx :acct {:id 2 :bal 10})))
      (is (= (count (repo/all r (query/from :acct))) 2))
      ;; throw → rolled back, and the error propagates
      (is (= (first (try
                      (repo/transaction r
                        (fn (tx)
                          (repo/update tx :acct {:bal 0} [:= :id 1])
                          (throw "boom")))
                      (catch _ [:caught])))
            :caught))
      (is (= (get (repo/one r (-> (query/from :acct) (query/where [:= :id 1]))) :bal) 90))
      (repo/close r)))

  (test "associations: has-many / belongs-to preload (one query each)"
    (let (r (repo/open (pg/adaptor) (opts))
          users {:table :users
                 :primary-key :id
                 :fields {:id :integer :name :text}
                 :associations {:posts {:type :has-many :table :posts :fk :author_id}}}
          posts {:table :posts
                 :primary-key :id
                 :fields {:id :integer :author_id :integer :title :text}
                 :associations {:author {:type :belongs-to
                                         :table :users
                                         :fk :author_id
                                         :references :id}}})
      (repo/exec r "create temp table users (id int primary key, name text)" [])
      (repo/exec r "create temp table posts (id int primary key, author_id int, title text)" [])
      (repo/insert r :users {:id 1 :name "ada"})
      (repo/insert r :users {:id 2 :name "grace"})
      (repo/insert r :posts {:id 10 :author_id 1 :title "a1"})
      (repo/insert r :posts {:id 11 :author_id 1 :title "a2"})
      (repo/insert r :posts {:id 12 :author_id 2 :title "g1"})
      (let (us (repo/preload r
                 users
                 (repo/all r (-> (query/from :users) (query/order-by :id)))
                 :posts))
        (is (= (count (get (first us) :posts)) 2))
        (is (= (count (get (second us) :posts)) 1)))
      (let (ps (repo/preload r
                 posts
                 (repo/all r (-> (query/from :posts) (query/order-by :id)))
                 :author))
        (is (= (get (get (first ps) :author) :name) "ada"))
        (is (= (get (get (nth ps 2) :author) :name) "grace")))
      (repo/close r)))

  (test "nested preload {:posts :comments} loads two levels"
    (let (r (repo/open (pg/adaptor) (opts))
          comment {:table :comments
                   :primary-key :id
                   :fields {:id :integer :post_id :integer :body :text}}
          post {:table :posts
                :primary-key :id
                :fields {:id :integer :author_id :integer :title :text}
                :associations {:comments {:type :has-many
                                          :table :comments
                                          :fk :post_id
                                          :schema (fn () comment)}}}
          users {:table :users
                 :primary-key :id
                 :fields {:id :integer :name :text}
                 :associations {:posts {:type :has-many
                                        :table :posts
                                        :fk :author_id
                                        :schema (fn () post)}}})
      (repo/exec r "create temp table users (id int primary key, name text)" [])
      (repo/exec r "create temp table posts (id int primary key, author_id int, title text)" [])
      (repo/exec r "create temp table comments (id int primary key, post_id int, body text)" [])
      (repo/insert r :users {:id 1 :name "ada"})
      (repo/insert r :posts {:id 10 :author_id 1 :title "a1"})
      (repo/insert r :posts {:id 11 :author_id 1 :title "a2"})
      (repo/insert r :comments {:id 100 :post_id 10 :body "c1"})
      (repo/insert r :comments {:id 101 :post_id 10 :body "c2"})
      (repo/insert r :comments {:id 102 :post_id 11 :body "c3"})
      (let (us (repo/preload r
                 users
                 (repo/all r (-> (query/from :users) (query/order-by :id)))
                 {:posts :comments}))
        (let (ps (get (first us) :posts))
          (is (= (count ps) 2))
          (is (= (count (get (first ps) :comments)) 2))
          (is (= (count (get (second ps) :comments)) 1))))
      (repo/close r)))

  (test "many-to-many preload via a join table (two queries)"
    (let (r (repo/open (pg/adaptor) (opts))
          tag {:table :tags :primary-key :id :fields {:id :integer :name :text}}
          post {:table :posts
                :primary-key :id
                :fields {:id :integer :title :text}
                :associations {:tags {:type :many-to-many
                                      :table :tags
                                      :join-table :post_tags
                                      :join-keys [:post_id :tag_id]
                                      :references :id
                                      :schema (fn () tag)}}})
      (repo/exec r "create temp table posts (id int primary key, title text)" [])
      (repo/exec r "create temp table tags (id int primary key, name text)" [])
      (repo/exec r "create temp table post_tags (post_id int, tag_id int)" [])
      (repo/insert r :posts {:id 10 :title "a1"})
      (repo/insert r :posts {:id 11 :title "a2"})
      (repo/insert r :tags {:id 1 :name "elixir"})
      (repo/insert r :tags {:id 2 :name "lisp"})
      (repo/insert r :tags {:id 3 :name "sql"})
      (repo/exec r "insert into post_tags values (10,1),(10,2),(11,3)" [])
      (let (ps (repo/preload r
                 post
                 (repo/all r (-> (query/from :posts) (query/order-by :id)))
                 :tags))
        (is (= (count (get (first ps) :tags)) 2))
        (is (= (count (get (second ps) :tags)) 1))
        (is (= (sort (map (get (first ps) :tags) (fn (t) (get t :name)))) (list "elixir" "lisp")))
        (is (= (get (first (get (second ps) :tags)) :name) "sql")))
      (repo/close r)))
  (test "nested transactions are savepoints: an inner failure rolls back only the inner work"
    (let (r (repo/open (pg/adaptor) (opts)))
      (repo/exec r "create temp table nest_t (id int)" [])
      (repo/transaction r
        (fn (tx)
          (repo/insert tx :nest_t {:id 1})
          (check-allow :discarded-catch
            (try
              (repo/transaction tx (fn (inner) (repo/insert inner :nest_t {:id 2}) (throw "inner")))
              (catch _ nil)))
          (repo/insert tx :nest_t {:id 3})))
      (is (= (map (repo/all r (-> (query/from :nest_t) (query/order-by :id)))
               (fn (row) (get row :id)))
            (list 1 3)))
      (repo/close r)))

  (test "joins, aggregates, upserts and increments run as compiled"
    (let (r (repo/open (pg/adaptor) (opts)))
      (repo/exec r "create temp table orgs (id int primary key, name text)" [])
      (repo/exec r
        "create temp table members (org_id int, user_id int, role text, primary key (org_id, user_id))"
        [])
      (repo/exec r "create temp table counts (k text primary key, n int)" [])
      (repo/insert-all r :orgs [{:id 1 :name "a"} {:id 2 :name "b"}] {:returning :none})
      (repo/insert-all r
        :members [{:org_id 1 :user_id 9 :role "admin"} {:org_id 2 :user_id 9 :role "read"}])
      (is (= (repo/all r
               (-> (query/from :orgs :o)
                 (query/select [:o.name :m.role])
                 (query/join :members :m [:= :m.org_id [:col :o.id]])
                 (query/where [:= :m.user_id 9])
                 (query/order-by :o.name)))
            (list {:name "a" :role "admin"} {:name "b" :role "read"})))
      (is (= (repo/count-rows r (query/from :members)) 2))
      (is (= (repo/aggregate r (query/from :orgs) :max :id) 2))
      (is (repo/exists? r (-> (query/from :orgs) (query/where [:= :name "b"]))))
      (refute (repo/exists? r (-> (query/from :orgs) (query/where [:= :name "z"]))))
      ;; an upsert that adds to the existing count
      (doseq (_ (range 3))
        (repo/insert r
          :counts {:k "x" :n 1}
          {:on-conflict {:target [:k] :do {:n [:+ :counts.n [:excluded :n]]}}}))
      (is (= (get (repo/one r (query/from :counts)) :n) 3))
      (is (nil? (repo/insert r :counts {:k "x" :n 5} {:on-conflict {:target [:k]}})))
      ;; an increment in an update
      (repo/update r :counts {:n [:+ :n 10]} [:= :k "x"] {:returning :none})
      (is (= (get (repo/one r (query/from :counts)) :n) 13))
      (repo/close r)))

  (test "a constraint violation names its constraint, and a changeset maps it to a field"
    (let (r (repo/open (pg/adaptor) (opts))
          people {:table :people
                  :primary-key :id
                  :fields {:id :serial :email [:text {:null false}]}})
      (repo/exec r "create temp table people (id serial primary key, email text not null)" [])
      (repo/exec r "create unique index people_email_idx on people (email)" [])
      (let (cs (fn (email)
                 (-> (changeset/cast {} {"email" email} [:email] people)
                   (changeset/validate-required [:email])
                   (changeset/unique-constraint :email {:name "people_email_idx"}))))
        (let ([tag row] (repo/insert-changeset r (cs "a@b")))
          (is (= tag :ok))
          (is (= (get row :email) "a@b"))
          (let ([tag2 failed] (repo/insert-changeset r (cs "a@b")))
            (is (= tag2 :error))
            (is (= (changeset/error-for failed :email) "has already been taken"))
            (is (= (changeset/action failed) :insert)))
          ;; an update through the changeset, found by primary key
          (let ([tag3 updated] (repo/update-changeset r
                                 (changeset/cast row {"email" "c@d"} [:email] people)))
            (is (= tag3 :ok))
            (is (= (get updated :email) "c@d"))))
        ;; an invalid changeset never reaches the database
        (is (= (first (repo/insert-changeset r (cs ""))) :error)))
      (let (e (try (repo/insert r :people {:email "c@d"}) (catch e e)))
        (is (= (get e :violation) :unique))
        (is (= (get e :constraint) "people_email_idx")))
      (repo/close r))))

;; Migrations against a real database. Real tables (a migration's DDL is not temporary),
;; named for this suite and dropped before and after, with a history table of their own.
(def- history :store_pg_test_migrations)

(def- migrations
  [{:version 20260101000000
    :name "widgets"
    :up [[:create-table
           :store_pg_widgets {:primary-key :id :fields {:id :serial :name [:text {:null false}]}}]
          [:create-index :store_pg_widgets {:columns [:name] :unique true}]]}
    {:version 20260102000000
     :name "widgets-colour"
     :up [[:add-column :store_pg_widgets :colour [:text {:default "red"}]]
           [:execute
             "UPDATE store_pg_widgets SET colour = 'blue'"
             "UPDATE store_pg_widgets SET colour = NULL"]]}])

(defn- clean (r)
  (repo/exec r "DROP TABLE IF EXISTS store_pg_widgets" [])
  (repo/exec r "DROP TABLE IF EXISTS store_pg_test_migrations" []))

(describe "migrations over the pg adaptor"
  :isolated (test "migrate applies each pending migration once, rollback undoes the newest"
    (let (r (repo/open (pg/adaptor) (assoc (opts) :size 2)))
      (clean r)
      (is (= (count (migration/pending r migrations {:table history})) 2))
      (is (= (map (migration/migrate r migrations {:table history}) (fn (m) (get m :name)))
            (list "widgets" "widgets-colour")))
      (is (= (migration/migrate r migrations {:table history}) []))
      (is (= (map (migration/status r migrations {:table history}) (fn (s) (get s :state)))
            (list :up :up)))
      (repo/insert r :store_pg_widgets {:name "w"})
      (is (= (get (repo/one r (query/from :store_pg_widgets)) :colour) "red"))
      (is (= (map (migration/rollback r migrations {:table history}) (fn (m) (get m :name)))
            (list "widgets-colour")))
      (is (= (repo/columns r :store_pg_widgets) (list :id :name)))
      (is (= (map (migration/status r migrations {:table history}) (fn (s) (get s :state)))
            (list :up :down)))
      (clean r)
      (repo/close r)))
  (test "a failing migration leaves neither its changes nor its record"
    (let (r (repo/open (pg/adaptor) (assoc (opts) :size 2))
          broken (conj migrations
                   {:version 20260103000000
                    :name "broken"
                    :up [[:add-column :store_pg_widgets :size :integer]
                          [:execute "SELECT no_such_function()"]]}))
      (clean r)
      (is (= (first (try (migration/migrate r broken {:table history}) (catch _ [:failed])))
            :failed))
      (is (= (count (migration/pending r broken {:table history})) 1))
      (refute (includes? (repo/columns r :store_pg_widgets) :size))
      (clean r)
      (repo/close r)))
  (test "two migrators at once: the lock makes the second wait, then find nothing to do"
    (let (r (repo/open (pg/adaptor) (assoc (opts) :size 3))
          me (self))
      (clean r)
      (doseq (_ (range 2))
        (spawn (fn ()
                 (send me [:migrated (count (migration/migrate r migrations {:table history}))]))))
      (let (counts (map (range 2) (fn (_) (receive ([:migrated n] n) (after 20000 :timeout)))))
        (is (= (sort counts) (list 0 2))))
      (clean r)
      (repo/close r))))

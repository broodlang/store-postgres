;; store-postgres — a PostgreSQL adaptor for the `store` storage library.
;;
;; Contains the native Postgres wire driver (SCRAM auth, the v3 simple + extended
;; query protocols, type codecs) and a supervised connection pool — all pure Brood
;; over net/tcp's binary mode, no libpq — plus the `pg` module, which implements
;; `store`'s adaptor contract over that driver. `store` itself is adaptor-agnostic;
;; this package makes it speak to Postgres.
(project
  :name "store-postgres"
  :version "0.2.2"
  :description
    "A PostgreSQL adaptor for the `store` storage library: a native Postgres wire driver (SCRAM, v3 protocol, type codecs) and a supervised connection pool, pure Brood over net/tcp."
  :repository "https://github.com/broodlang/store-postgres"
  :dependencies [[store :version "0.2.2"]])

(defmodule pg/spike
  "Spike runner: connect to Postgres, authenticate (SCRAM-SHA-256 / md5 / cleartext),
  and run a couple of simple queries — proving the wire driver end to end against a
  real server. Run with `nest run --main pg/spike`. Connection settings from $PG* env."
  (:alias conn)
  (:alias pool))

(defn env (name default)
  (or (os/env name) default))

(defn opts ()
  {:host (env "PGHOST" "127.0.0.1")
   :port (string/->number (env "PGPORT" "5432"))
   :user (env "PGUSER" "postgres")
   :password (env "PGPASSWORD" "")
   :database (env "PGDATABASE" "postgres")})

(defn show (result)
  (io/puts "  columns:" (get result :columns))
  (io/puts "  rows:")
  (map (fn (row) (io/puts "   " row)) (get result :rows)))

(defn run-query (c sql)
  "Run `sql` (no params), print its columns and rows, return the threaded conn."
  (io/puts "")
  (io/puts "sql>" sql)
  (let (res (conn/query c sql)
        c (get res 1))
    (show (get res 0))
    c))

(defn run-exec (c sql params)
  "Run a parameterized `sql` with `params`, print the result, return the conn."
  (io/puts "")
  (io/puts "sql>" sql "  params:" params)
  (let (res (conn/exec c sql params)
        c (get res 1))
    (show (get res 0))
    c))

(defn demo-pool (o)
  "Exercise the pool: sequential, concurrent (more jobs than connections), and
  kill-and-recover."
  (io/puts "")
  (io/puts "=== pool (size 3) ===")
  (let (p (pool/start (assoc o :size 3)))
    (io/puts "")
    (io/puts "sequential:")
    (io/puts "  query:" (get (pool/query p "select 'hello from the pool' as msg") :rows))
    (io/puts "  exec :" (get (pool/exec p "select $1::int * 2 as doubled" [21]) :rows))

    (io/puts "")
    (io/puts "6 concurrent jobs through 3 connections (backend pid shows reuse):")
    (let (parent (self))
      (map (fn (i)
             (spawn (let (res (pool/query p
                                (str "select " i " as job, pg_backend_pid() as backend")))
                      (send parent [:done (get res :rows)]))))
        (range 6))
      (map (fn (_) (receive ([:done rows] (io/puts "  ->" rows)))) (range 6)))

    (io/puts "")
    (io/puts "kill a connection mid-pool; pool drops + respawns it:")
    (let (victim (pool/checkout p))
      (io/puts "  killing" victim)
      (exit victim :killed)
      (pool/checkin p victim)) ; returning the dead pid — the pool ignores it
    (map (fn (i)
           (io/puts "  post-kill query" i ":" (get (pool/query p "select 'ok' as state") :rows)))
      (range 4))

    (pool/stop p)
    (io/puts "")
    (io/puts "pool stopped.")))

(defn main ()
  (let (o (opts))
    (io/puts (str "Connecting to "
               (get o :user)
               "@"
               (get o :host)
               ":"
               (get o :port)
               "/"
               (get o :database)
               " …"))
    (let (c (conn/connect o))
      (io/puts "Connected. server_version =" (get (get c :params) "server_version"))
      (let (c (run-query c "select version()")
            ;; typed decoding: int4, text, bool, float8, numeric, NULL
            c (run-query c
                "select 1 as i, 'hi' as s, true as b, 2.5::float8 as f, 9.99::numeric as money, null as n")
            ;; parameterized: values bound server-side, decoded back to Brood types
            c (run-exec c "select $1::int + $2::int as sum" [40 2])
            c (run-exec c "select $1 as greeting, $2::bool as flag" ["hello, $params" true])
            c (run-exec c
                "select n, n * $1::int as scaled from generate_series(1,3) as n"
                [10])
            ;; injection attempt is just data, not SQL
            c (run-exec c "select $1 as raw" ["'; drop table users; --"]))
        (conn/close c)
        (io/puts "")
        (io/puts "Single-connection demo done.")
        (demo-pool o)
        (io/puts "")
        (io/puts "Spike complete.")))))

(defmodule pool
  "A fixed-size connection pool, run under a supervisor, that keeps its connections open by
  itself.

  The shape, and why each part is there (a production pool once stopped answering for
  good while its process stayed alive, so every request waited on it forever):

  - **The pool process runs under `std/proc/supervisor`**, registered under a name of its
    own. A pool that crashes is restarted with fresh connections, and callers reach it by
    that name through the handle `start` returns, never by a pid that goes stale.
  - **Its connection processes are linked to it** (`spawn-link`; the pool traps exits).
    A connection that dies reaches the pool as `[:EXIT …]`; a pool that dies takes its
    connections with it, so their sockets close instead of sitting idle on the server.
  - **The pool never blocks.** Opening a connection is a process of its own that reports
    `[:started]` / `[:start-failed]` back into the pool's loop. Each open has a deadline;
    while the server cannot be reached the pool retries with a doubling backoff (up to
    `*retry-max-ms*`), so it is back to full size by itself once the server is.
  - **`checkout` monitors the pool and has a deadline**: a dead pool raises at once, a
    pool with nothing to give raises when the deadline passes — a `:connection`
    store-error, never a hang. A request that gives up withdraws from the queue, and a
    connection handed over in that moment goes straight back.

  Clients check a connection out, use it, and check it back in; `query`/`exec` do that
  round-trip. Checkouts beyond the pool size queue until one frees up. State:

    {:opts     connection opts, for opening more
     :size     the number of connections the pool keeps
     :sup      the supervisor (its exit ends the pool)
     :members  live connection pids
     :free     the subset currently available (a stack: see `give-back`)
     :pending  pid -> {:ref :deadline} for each connection being opened
     :retry-at when the pool may open again after a failed open (ms), :backoff the wait
     :borrowed connection pid -> {:by borrower :mon monitor}
     :waiters  an amortized-O(1) FIFO ({:in :out}, see below) of [from ref] pairs
     :ready    whether the first round of opens is in, :first-error its first failure,
               :ready-waiters who asked for it (`start`)}"
  (:alias connection))

;; ---- tuning -----------------------------------------------------------------

;; How long `checkout` waits for a connection (a pool's own `:checkout-timeout-ms` wins).
(def *checkout-timeout-ms* 5000)

;; How long one connection may take to open — connect, TLS-free startup and SCRAM — before
;; the pool gives up on it and tries again (a pool's own `:connect-timeout-ms` wins).
(def *connect-timeout-ms* 20000)

;; The retry backoff after a failed open: it starts here, doubles per failure, and stops
;; growing at the max, so an unreachable server is tried every few seconds and never
;; hammered, and a server that comes back is found within `*retry-max-ms*`.
(def *retry-min-ms* 100)
(def *retry-max-ms* 5000)

;; How a pool that crashes is restarted: at most this many restarts in this many seconds
;; before the supervisor gives up (a crash loop is a bug; a server that is down is not a
;; crash, the pool waits that out by itself).
(def *max-restarts* 20)
(def *max-restart-seconds* 60)

;; ---- lifecycle --------------------------------------------------------------

(defn start (opts)
  "Start a supervised pool and wait until its first connections are open. `opts` is the
  connection opts plus `:size` (default 5), `:checkout-timeout-ms`, `:connect-timeout-ms`
  and `:watchdog` (a map of `watchdog` settings, or false for none; see `watch`).
  Returns the pool's handle, or throws the first connection's error (the pool is stopped
  then)."
  (let (name (keyword (str "store-postgres-pool-" (rand/token 8)))
        sup (supervisor/start
              [{:id :pool
                :name name
                :start (fn () (let (sup (self)) (spawn-link (init opts sup))))
                ;; graceful first (close each connection with a Terminate), then a kill
                :shutdown 5000}]
              {:max-restarts *max-restarts* :max-seconds *max-restart-seconds*})
        handle {:name name
                :supervisor sup
                :checkout-timeout-ms (get opts :checkout-timeout-ms *checkout-timeout-ms*)}
        ready (await-ready handle
                (+ (get opts :connect-timeout-ms *connect-timeout-ms*) 5000)))
    (if (= ready :ok)
      (let (settings (get opts :watchdog {}))
        (if (= settings false)
          handle
          (assoc handle :watchdog (watch handle settings))))
      (do
        (stop handle)
        (throw ready)))))

(defn stop (pool)
  "Stop the pool: its watchdog first, then its connections close and its supervisor exits.
  Returns `:ok`, or `:timeout` if the supervisor is still there after ten seconds."
  (when-let (watchdog (get pool :watchdog))
    (exit watchdog :kill))
  (let (sup (get pool :supervisor)
        m (monitor sup))
    (gen/stop sup)
    (receive
      ([:down ^m _ _] :ok)
      (after 10000 :timeout))))

(defn pool-pid (pool)
  "The pid of the pool process behind handle `pool` right now, or nil (stopped, or between
  a crash and its restart)."
  (proc/whereis (get pool :name)))

(defn await-ready (pool ms)
  "Wait up to `ms` for the pool's first round of opens: `:ok`, or the first error."
  (let (deadline (+ (os/now) ms)
        pid (resolve pool deadline))
    (if (nil? pid)
      (connection-failure "store: the connection pool did not start" false)
      (let (m (monitor pid)
            r (ref))
        (send pid [:await-ready (self) r])
        (receive
          ([:reply ^r v] (do (demonitor m) v))
          ([:down ^m _ reason]
            (connection-failure (str "store: the connection pool died while starting: " reason)
              false))
          (after (remaining deadline)
            (do
              (demonitor m)
              (connection-failure "store: the pool's connections did not open in time" true))))))))

;; ---- the watchdog ---------------------------------------------------------------
;; A pool can be alive and still give nothing: a production pool once stopped answering
;; for a week while its process lived, and nothing restarted it. The watchdog asks the pool
;; itself (a `SELECT 1` through `query`, so through checkout, as a request would) every
;; `:check-ms`. When that has failed for `:restart-after-ms` it kills the pool process,
;; which its supervisor restarts with fresh connections; when the checks still fail
;; `:exit-after-ms` after the first failure and `:exit?` is set, it exits the OS process
;; with code 1, for the platform to restart (an app's deploy sets `:exit?`, hatch's
;; `web/repo` outside dev; a library or a test never wants it). Each step is logged at
;; `:error`. It is not linked to the pool, so a pool that crashes does not take it along.

(def *watchdog-defaults*
  {:check-ms 15000
   ;; a check that has not answered by then has failed (its probe is killed)
   :probe-timeout-ms 10000
   :restart-after-ms 180000
   :exit-after-ms 300000
   ;; and never on fewer failed checks than this in a row (a machine suspended between two
   ;; checks must not count the time it slept)
   :min-failures 3
   :exit? false})

(defn watch (pool settings)
  "Start the watchdog of `pool` (a handle from `start`) with `settings` over
  `*watchdog-defaults*` (`:log`, a `(fn (level message))`, and `:halt`, a `(fn (code))`,
  replace how it logs and exits). Returns its pid; `stop` stops it."
  (let (config (merge *watchdog-defaults* settings))
    (spawn (watchdog-init pool config))))

(defn watchdog-init (pool config)
  (let (sup-mon (monitor (get pool :supervisor)))
    (watchdog-loop pool config sup-mon fresh-watch)))

(def fresh-watch {:failing-since nil :failures 0 :restarted-at nil})

(defn watchdog-loop (pool config sup-mon state)
  (receive
    ;; `stop` kills the watchdog before it stops the supervisor, so a supervisor that goes
    ;; while the watchdog lives went by itself: the pool is gone and will not come back.
    ([:down ^sup-mon _ reason] (pool-gone config reason))
    (after (get config :check-ms)
      (watchdog-loop pool config sup-mon (watch-step pool config state (probe pool config))))))

(defn probe (pool config)
  "Whether a `SELECT 1` through the pool answers within `:probe-timeout-ms`."
  (let (parent (self)
        r (ref)
        pid (spawn (send parent
                     [:probe
                       r
                       (check-allow :discarded-catch
                         (try (do (query pool "select 1") true) (catch _ false)))])))
    (receive
      ([:probe ^r ok] ok)
      (after (get config :probe-timeout-ms)
        (do
          ;; the pool reclaims (and replaces) any connection it held
          (exit pid :kill)
          false)))))

(defn watch-step (pool config state ok)
  "The watchdog's state after a check that answered `ok`, acting on it: log a recovery,
  restart the pool, or exit."
  (let (now (os/now)
        since (get state :failing-since))
    (if ok
      (do
        (when since
          (watch-log config
            :warn (str "store-postgres watchdog: the database answers through the pool again, after "
              (seconds (- now since))
              " s of failed checks")))
        fresh-watch)
      (let (since (or since now)
            failures (inc (get state :failures))
            failing-ms (- now since)
            restarted-at (get state :restarted-at)
            state (assoc state :failing-since since :failures failures))
        (when (= failures 1)
          (watch-log config :warn "store-postgres watchdog: a check through the pool failed"))
        (cond
          (< failures (get config :min-failures)) state
          (and (get config :exit?) restarted-at (>= failing-ms (get config :exit-after-ms)))
            (do
              (watch-log config
                :error (str "store-postgres watchdog: DATABASE UNREACHABLE THROUGH THE POOL FOR "
                  (seconds failing-ms)
                  " s, and restarting the pool did not bring it back: EXITING with code 1 for the platform to restart this machine"))
              ((get config :halt system/halt) 1)
              state)
          (>= (- now (or restarted-at since)) (get config :restart-after-ms))
            (do
              (watch-log config
                :error (str "store-postgres watchdog: DATABASE UNREACHABLE THROUGH THE POOL FOR "
                  (seconds failing-ms)
                  " s ("
                  failures
                  " failed checks): RESTARTING THE POOL"))
              (restart-pool pool config)
              (assoc state :restarted-at now))
          else state)))))

(defn restart-pool (pool config)
  "Kill the pool process; its supervisor starts a fresh one, with fresh connections."
  (let (pid (pool-pid pool))
    (if pid
      (exit pid :kill)
      (watch-log config :error "store-postgres watchdog: no pool process to restart"))))

(defn pool-gone (config reason)
  "The pool's supervisor exited by itself: no pool will come back. Exit when `:exit?`."
  (watch-log config
    :error (str "store-postgres watchdog: THE POOL'S SUPERVISOR EXITED ("
      (pr-str reason)
      "): the pool is gone for good"
      (if (get config :exit?) "; EXITING with code 1 for the platform to restart this machine" "")))
  (when (get config :exit?)
    ((get config :halt system/halt) 1))
  :gone)

(defn watch-log (config level message)
  "Log `message` at `level` through `:log`, else std `log` and, at `:error`, straight to
  stderr as well (the logger is a process too, and an exit must not lose the line)."
  (let (custom (get config :log))
    (if custom
      (custom level message)
      (do
        (log/log level message)
        (when (= level :error)
          (io/puts message :to *err*))))))

(defn seconds (ms) (math/round (/ ms 1000)))

;; ---- the pool process ---------------------------------------------------------

(defn init (opts sup)
  "The pool process: trap exits (its connections are linked to it), start opening its
  connections, and serve."
  (proc/trap-exit true)
  (let (state (open-missing {:opts opts
                             :size (get opts :size 5)
                             :sup sup
                             :members []
                             :free []
                             :pending {}
                             :retry-at 0
                             :backoff 0
                             :borrowed {}
                             :waiters no-waiters
                             :ready false
                             :first-error nil
                             :ready-waiters []})
        initial (into [] (keys (get state :pending))))
    (run (assoc state :initial initial :ready (empty? initial)))))

(defn run (state)
  (receive
    ([:checkout from r]
      (let (free (get state :free))
        (if (empty? free)
          (run (assoc state :waiters (waiters-push (get state :waiters) [from r])))
          (run (hand-out (assoc state :free (rest-v free)) (first free) from r)))))
    ;; A checkout that gave up at its deadline. Whatever it was handed before this arrived
    ;; is already on its way and comes back as a checkin; `:cancelled` follows it, so the
    ;; caller knows nothing more is coming.
    ([:cancel from r] (send from [:cancelled r])
      (run (assoc state :waiters (waiters-remove (get state :waiters) r))))
    ([:checkin pid]
      ;; accept only a live member that isn't already free (ignore dead/double checkin)
      (if (and (includes? (get state :members) pid) (not (includes? (get state :free) pid)))
        (run (give-back state pid))
        (run state)))
    ([:started r] (run (connected state r)))
    ([:start-failed r err]
      (run (open-missing (open-failed state (pending-by-ref (get state :pending) r) err))))
    ([:EXIT pid reason] (exited state pid reason))
    ;; A BORROWER died holding a connection (e.g. a request handler hard-killed on
    ;; timeout, which would otherwise leak the connection out of the pool forever). Its
    ;; connection is in whatever state the borrower left it — inside an open transaction,
    ;; or mid-reply — so it is NOT handed on: the next borrower's statements would run
    ;; inside that transaction and hold its locks. Kill it (the server rolls back when the
    ;; socket closes) and open a fresh one in its place. Its own `[:EXIT]` then arrives
    ;; as a non-member's, and is ignored.
    ([:down _m pid _reason]
      (let (conn (conn-of-borrower (get state :borrowed) pid))
        (if (nil? conn)
          (run state)
          (do
            (exit conn :kill)
            (run (open-missing (remove-conn (clear-borrow state conn) conn)))))))
    ([:await-ready from r]
      (if (get state :ready)
        (do
          (send from [:reply r (or (get state :first-error) :ok)])
          (run state))
        (run (assoc state :ready-waiters (conj (get state :ready-waiters) [from r])))))
    ;; The supervisor stopping us: close each connection cleanly, then exit normally.
    ([:$stop] (shut-down state))
    ;; An open past its deadline, or the backoff over: give up on the one, try again.
    (after (wait-ms state) (run (open-missing (expire state))))))

(defn exited (state pid reason)
  "A linked process exited: the supervisor (so the pool goes too), a member (replace it),
  or a connection being opened (a failed open)."
  (cond
    ;; Trapping exits turns the supervisor's death into a message; die with it, which
    ;; takes the connections down too.
    (= pid (get state :sup)) (exit (self) :kill)
    (includes? (get state :members) pid)
      (run (open-missing (remove-conn (clear-borrow state pid) pid)))
    (contains? (get state :pending) pid)
      (run (open-missing (open-failed state
                           pid
                           {:store-error :connection
                            :message (str "store: the connecting process died: " reason)})))
    ;; one the pool already let go of (killed, or given up on): nothing to do
    else (run state)))

(defn shut-down (state)
  (doseq (pid (keys (get state :pending)))
    (exit pid :kill))
  (doseq (pid (get state :members))
    (connection/stop pid))
  :stopped)

;; ---- opening connections ------------------------------------------------------

(defn open-missing (state)
  "Start opening each connection the pool is short of — at once, or when the backoff after
  a failed open is over."
  (let (missing (shortfall state))
    (if (and (> missing 0) (>= (os/now) (get state :retry-at)))
      (fold (range missing) state (fn (acc _i) (open-one acc)))
      state)))

(defn shortfall (state)
  "How many connections the pool is short of, counting those being opened."
  (let (missing (- (get state :size) (+ (count (get state :members)) (count (get state :pending)))))
    (if (int? missing) missing 0)))

(defn open-one (state)
  "Spawn one connection, linked to the pool, that reports `[:started]` or `[:start-failed]`
  back here and then serves."
  (let (opts (get state :opts)
        pool (self)
        r (ref)
        pid (spawn-link (connection/boot opts pool r))
        deadline (+ (os/now) (get opts :connect-timeout-ms *connect-timeout-ms*)))
    (assoc state :pending (assoc (get state :pending) pid {:ref r :deadline deadline}))))

(defn pending-by-ref (pending r)
  "The pid of the open `pending` knows by ref `r`, or nil (one the pool gave up on)."
  (fold (keys pending) nil (fn (acc pid) (if (= (get (get pending pid) :ref) r) pid acc))))

(defn connected (state r)
  "An open finished: the connection joins the pool and goes to a waiter or the free stack."
  (let (pid (pending-by-ref (get state :pending) r))
    (if (nil? pid)
      ;; given up on at its deadline and killed already; its `[:started]` was on the way
      state
      (let (state (settle-first-round (assoc state
                                        :pending (dissoc (get state :pending) pid)
                                        :backoff 0)
                    pid nil))
        (give-back (assoc state :members (conj (get state :members) pid)) pid)))))

(defn open-failed (state pid err)
  "An open failed with `err`: forget it, and wait out a longer backoff before the next."
  (if (nil? pid)
    state
    (let (backoff (math/min *retry-max-ms* (math/max *retry-min-ms* (* 2 (get state :backoff)))))
      (settle-first-round (assoc state
                            :pending (dissoc (get state :pending) pid)
                            :backoff backoff
                            :retry-at (+ (os/now) backoff))
        pid err))))

(defn expire (state)
  "Give up on every open past its deadline: kill it and count it as failed."
  (let (now (os/now))
    (fold (into [] (get state :pending))
      state
      (fn (acc entry)
        (let ([pid info] entry)
          (if (>= now (get info :deadline))
            (do
              (exit pid :kill)
              (open-failed acc
                pid
                {:store-error :connection
                 :timeout true
                 :message "store: timed out connecting to the server"}))
            acc))))))

(defn wait-ms (state)
  "How long the pool's loop may wait for a message: until the nearest open deadline, or
  the end of the backoff when the pool is short of connections."
  (let (deadlines (map (into [] (get state :pending)) (fn (entry) (get (get entry 1) :deadline)))
        times (if (> (shortfall state) 0) (cons (get state :retry-at) deadlines) deadlines))
    (if (empty? times)
      60000
      (remaining (fold (rest times) (first times) math/min)))))

(defn settle-first-round (state pid err)
  "Count `pid` out of the first round of opens; once the round is in, answer whoever
  waits on it (`start`) with `:ok` or its first error."
  (let (initial (get state :initial))
    (if (not (includes? initial pid))
      state
      (let (left (remove-pid initial pid)
            state (assoc state :initial left :first-error (or (get state :first-error) err)))
        (if (empty? left)
          (do
            (doseq (w (get state :ready-waiters))
              (send (get w 0) [:reply (get w 1) (or (get state :first-error) :ok)]))
            (assoc state :ready true :ready-waiters []))
          state)))))

;; ---- lending ------------------------------------------------------------------

(defn hand-out (state pid borrower r)
  "Hand connection `pid` to `borrower`, recording the borrow and monitoring the borrower
  so a connection is reclaimed if the borrower dies without checking in."
  (let (mon (monitor borrower))
    (send borrower [:reply r pid])
    (assoc state :borrowed (assoc (get state :borrowed) pid {:by borrower :mon mon}))))

(defn clear-borrow (state pid)
  "Demonitor and drop connection `pid`'s borrow record (a no-op if it isn't borrowed)."
  (let (b (get (get state :borrowed) pid)
        _ (when b (demonitor (get b :mon))))
    (assoc state :borrowed (dissoc (get state :borrowed) pid))))

(defn conn-of-borrower (borrowed borrower)
  "The connection pid `borrower` currently holds, or nil."
  (fold (keys borrowed) nil (fn (acc k) (if (= (get (get borrowed k) :by) borrower) k acc))))

;; ---- waiters: an amortized-O(1) FIFO ----------------------------------------
;; A plain vector made enqueue (`into … [w]`) and dequeue (`rest`) each O(waiters), so a
;; thundering herd of N blocked checkouts churned O(N²). A two-list queue — push onto
;; `:in`, pop from `:out`, flipping `:in` (reversed) into `:out` when `:out` drains — is
;; amortized O(1) per op and keeps FIFO fairness, so no waiter starves under load.

(def no-waiters {:in (list) :out (list)})

(defn waiters-empty? (q)
  (and (empty? (get q :in)) (empty? (get q :out))))

(defn waiters-push (q w)
  (assoc q :in (cons w (get q :in))))

(defn waiters-pop (q)
  "The next waiter (FIFO) and the queue without it, as `[w q']`. Assumes a non-empty
  queue — callers gate on `waiters-empty?`."
  (let (out (get q :out))
    (if (empty? out)
      (let (flipped (reverse (get q :in)))
        [(first flipped) {:in (list) :out (rest flipped)}])
      [(first out) (assoc q :out (rest out))])))

(defn waiters-remove (q r)
  "The queue without the waiter whose ref is `r` (one that gave up). O(waiters), and only
  on a checkout's deadline."
  (let (keep? (fn (w) (not (= (get w 1) r))))
    {:in (seq/filter (get q :in) keep?) :out (seq/filter (get q :out) keep?)}))

;; ---- state helpers ----------------------------------------------------------

(defn rest-v (v) (into [] (rest v)))

(defn remove-pid (v pid)
  (into [] (seq/filter v (fn (x) (not (= x pid))))))

(defn remove-conn (state pid)
  (assoc state
    :members (remove-pid (get state :members) pid)
    :free (remove-pid (get state :free) pid)))

(defn give-back (state pid)
  "Return `pid` to circulation: hand it to the next waiter, else push it onto the free
  stack. Clears the outgoing borrow record (demonitor) first; a re-handout to a waiter
  re-monitors the new borrower.

  Free connections are a STACK, not a queue — `checkout` takes the front and this puts a
  returning connection back on the front, so a sequence of queries keeps landing on the
  connection that just served one. As a queue it round-robined instead, and every query
  paid for a cold connection process: its own heap, its own inline caches, and often
  another worker thread. Measured on the same `SELECT 1`, a pool of five cost 349us against
  a pool of one at 210us; taking the hot connection closes that gap, and it is the same
  reason other pools (HikariCP, PgBouncer) prefer the most recently used connection.

  Idle members are not stranded by this: each connection process runs its own keepalive
  timer, so one that sits at the bottom of the stack still pings and stays open."
  (let (state (clear-borrow state pid)
        q (get state :waiters))
    (if (waiters-empty? q)
      (assoc state :free (into [pid] (get state :free)))
      (let (popped (waiters-pop q)
            w (first popped))
        (hand-out (assoc state :waiters (get popped 1)) pid (get w 0) (get w 1))))))

;; ---- client API -------------------------------------------------------------

(defn checkout (pool)
  "Check a connection out of `pool` (a handle from `start`) and return its pid. Waits for
  one up to the pool's `:checkout-timeout-ms` (5 s by default), through a restart of the
  pool too; a pool that is gone, dies meanwhile, or has nothing to give in time raises a
  `:connection` store-error instead of hanging."
  (let (ms (get pool :checkout-timeout-ms *checkout-timeout-ms*)
        deadline (+ (os/now) ms)
        pid (resolve pool deadline))
    (if (nil? pid)
      (throw (connection-failure "store: the connection pool is not running" false))
      (let (m (monitor pid)
            r (ref))
        (send pid [:checkout (self) r])
        (receive
          ([:reply ^r conn] (do (demonitor m) conn))
          ([:down ^m _ reason]
            (throw (connection-failure (str "store: the connection pool died: " reason) false)))
          (after (remaining deadline)
            (do
              (send pid [:cancel (self) r])
              (await-cancelled pid r m)
              (throw (connection-failure (str "store: no connection from the pool within " ms " ms")
                       true)))))))))

(defn await-cancelled (pid r m)
  "After a checkout gave up: give back whatever the pool handed over before it saw the
  cancel, until its `[:cancelled]` (or its death) says nothing more is coming."
  (receive
    ([:reply ^r conn] (send pid [:checkin conn])
      (await-cancelled pid r m))
    ([:cancelled ^r] (demonitor m))
    ([:down ^m _ _] nil)
    (after 1000 (demonitor m))))

(defn resolve (pool deadline)
  "The pool process behind handle `pool`, waiting through a restart (when its name is
  briefly unregistered) until `deadline`; nil once the deadline passes or the supervisor
  is gone (the pool will not come back)."
  (let (pid (pool-pid pool))
    (cond
      (not (nil? pid)) pid
      (not (proc/alive? (get pool :supervisor))) nil
      (>= (os/now) deadline) nil
      else
        (do
          (pause 10)
          (resolve pool deadline)))))

(defn remaining (deadline)
  "Milliseconds from now until `deadline` (an `os/now` time), never below zero."
  (wait-time (- deadline (os/now))))

(defn wait-time (ms)
  "`ms` as a `receive` timeout: an int, never below zero."
  (if (int? ms) (math/max 0 ms) 0))

(defn connection-failure (message timeout?)
  "A `:connection` store-error, flagged `:timeout` when it came from a deadline."
  (if timeout?
    {:store-error :connection :timeout true :message message}
    {:store-error :connection :message message}))

(defn checkin (pool pid)
  "Return a checked-out connection to the pool. A pool restarted meanwhile does not know
  it, and ignores it (the old pool's connections died with it)."
  (let (p (pool-pid pool))
    (when p (send p [:checkin pid]))
    nil))

(defn with-conn (pool f)
  "Check a connection out, run `(f pid)`, and check it back in even if `f` throws."
  (let (pid (checkout pool))
    (try
      (let (result (f pid))
        (checkin pool pid)
        result)
      (catch e
        (do (checkin pool pid) (throw e))))))

;; A checked-out connection can be dead through no fault of the caller — a proxy
;; closed it while it sat in the pool (keepalive narrows but can't fully close this
;; race). Such a failure surfaces as a `:connection` store-error and the pool replaces
;; the dead member; retrying picks up a fresh one, so a transient close is invisible to
;; the caller. A genuine query error (`:query`) is NOT retried.
(def *max-attempts* 3)

(defn query (pool sql)
  "Run `sql` on a pooled connection, retrying a dead-connection failure. Returns the
  result, or throws on a genuine error."
  (with-retry pool (fn (pid) (connection/query pid sql)) *max-attempts*))

(defn exec (pool sql params)
  "Run parameterized `sql` with `params` on a pooled connection, retrying a
  dead-connection failure."
  (with-retry pool (fn (pid) (connection/exec pid sql params)) *max-attempts*))

(defn with-retry (pool f attempts)
  (let (tagged (with-conn pool (fn (pid) (f pid))))
    (cond
      (= (get tagged 0) :ok) (get tagged 1)
      (and (> attempts 1) (retryable? (get tagged 1)))
        (do
          (pause 50)
          (with-retry pool f (- attempts 1)))
      else (throw (get tagged 1)))))

(defn retryable? (err)
  "A dead/closed connection is worth retrying with a fresh one; a `:timeout` (the
  server went silent) is NOT — retrying only stacks more 15s waits and can blow the
  caller's request deadline. Fail fast instead."
  (and (connection-error? err) (not (get err :timeout))))

(defn connection-error? (err)
  (and (map? err) (= (get err :store-error) :connection)))

(defn pause (ms)
  "Sleep `ms` — a short backoff so the pool can replace a dead member before a retry."
  (receive (after ms nil)))

(defn unwrap (tagged)
  (if (= (get tagged 0) :ok)
    (get tagged 1)
    (throw (get tagged 1))))

(defmodule pool
  "A fixed-size connection pool that also supervises its connections.

  The pool process opens `:size` connection processes, monitors each, and respawns
  any that die — so supervision is folded into the pool rather than split across a
  separate supervisor (which would force a pid-reconciliation dance every restart).

  Clients check a connection out, use it, and check it back in; `query`/`exec` do
  that round-trip. Checkouts beyond the pool size queue until one frees up. State:

    {:opts    connection opts, for (re)spawning
     :members all live connection pids
     :free    the subset currently available
     :waiters an amortized-O(1) FIFO ({:in :out}, see below) of [from ref] pairs
              awaiting a connection}"
  (:alias connection))

;; ---- lifecycle --------------------------------------------------------------

(defn start (opts)
  "Start a pool. `opts` is the connection opts plus `:size` (default 5). Blocks until
  every connection is up; returns the pool pid, or throws if a connection fails."
  (let (size (get opts :size 5)
        parent (self)
        r (ref)
        pid (spawn (boot opts size parent r)))
    (receive
      ([:started ^r] pid)
      ([:start-failed ^r err] (throw err)))))

(defn boot (opts size parent r)
  (let (outcome (try {:pids (open-parallel opts size)} (catch e {:error e})))
    (if (get outcome :error)
      (send parent [:start-failed r (get outcome :error)])
      (let (pids (get outcome :pids)
            pool (self))
        (map pids monitor)
        ;; Self-heal: a ticker nudges the pool to replace any connections it couldn't
        ;; respawn immediately (e.g. the DB was unreachable when they died), so the pool
        ;; recovers on its own once the DB is back — no app restart (see `:replenish`).
        (spawn (replenish-ticker pool))
        (send parent [:started r])
        (run {:opts opts :size size :members pids :free pids :waiters no-waiters :borrowed {}})))))

;; How often the pool retries reconnecting while below its target size.
(def *replenish-ms* 5000)

(defn replenish-ticker (pool)
  "Send `pool` a `:replenish` nudge every *replenish-ms*. Runs as a child of the pool so
  the retry cadence is independent of request traffic."
  (receive (after *replenish-ms* :tick))
  (send pool [:replenish])
  (replenish-ticker pool))

(defn open-parallel (opts n)
  "Open `n` connections concurrently — each connects in its own green process, so
  the (PBKDF2-dominated) SCRAM handshakes overlap and startup is ~one handshake, not
  n of them. Spawn all, then collect each `[:started]`."
  (let (parent (self)
        pairs (into []
                (map (range n)
                  (fn (i)
                    (let (cr (ref))
                      {:ref cr :pid (spawn (connection/boot opts parent cr))})))))
    (into [] (map pairs await-started))))

(defn await-started (p)
  (let (cr (get p :ref)
        pid (get p :pid))
    (receive
      ([:started ^cr] pid)
      ([:start-failed ^cr e] (throw e)))))

(defn run (state)
  (receive
    ([:checkout from r] (let (free (get state :free))
                          (if (empty? free)
                            (run (assoc state :waiters (waiters-push (get state :waiters) [from r])))
                            (run (hand-out (assoc state :free (rest-v free)) (first free) from r)))))
    ([:checkin pid]
      ;; accept only a live member that isn't already free (ignore dead/double checkin)
      (if (and (includes? (get state :members) pid) (not (includes? (get state :free) pid)))
        (run (give-back state pid))
        (run state)))
    ([:down m pid reason]
      (if (includes? (get state :members) pid)
        ;; a connection died — drop it (clearing any borrow record) and respawn a replacement
        (run (respawn (remove-conn (clear-borrow state pid) pid)))
        ;; a BORROWER died holding a connection (e.g. a request handler hard-killed on
        ;; timeout, which would otherwise leak the connection out of the pool forever) —
        ;; reclaim its connection back into circulation.
        (let (conn (conn-of-borrower (get state :borrowed) pid))
          (if (nil? conn) (run state) (run (give-back state conn))))))
    ;; Periodic self-heal: replace connections while below target size.
    ([:replenish] (run (maybe-replenish state)))
    ([:stop from r] (map (get state :members) connection/stop)
      (send from [:reply r :ok]))))

(defn hand-out (state pid borrower r)
  "Hand connection `pid` to `borrower`, recording the borrow and monitoring the borrower
  so a connection is reclaimed if the borrower dies without checking in."
  (let (mon (monitor borrower))
    (send borrower [:reply r pid])
    (assoc state :borrowed (assoc (get state :borrowed) pid {:by borrower :mon mon}))))

(defn clear-borrow (state pid)
  "Demonitor and drop connection `pid`'s borrow record (a no-op if it isn't borrowed)."
  (let (b (get (get state :borrowed) pid)
        _ (when b (demonitor (get b :mon))))
    (assoc state :borrowed (dissoc (get state :borrowed) pid))))

(defn conn-of-borrower (borrowed borrower)
  "The connection pid `borrower` currently holds, or nil."
  (fold (keys borrowed) nil (fn (acc k) (if (= (get (get borrowed k) :by) borrower) k acc))))

(defn maybe-replenish (state)
  "If the pool is below its target size, try to open one connection back. A no-op when
  full; when reconnect fails (DB still down) the next tick retries."
  (if (< (count (get state :members)) (get state :size))
    (respawn state)
    state))

;; ---- waiters: an amortized-O(1) FIFO ----------------------------------------
;; A plain vector made enqueue (`into … [w]`) and dequeue (`rest`) each O(waiters), so a
;; thundering herd of N blocked checkouts churned O(N²). A two-list queue — push onto
;; `:in`, pop from `:out`, flipping `:in` (reversed) into `:out` when `:out` drains — is
;; amortized O(1) per op and keeps FIFO fairness, so no waiter starves under load.

(def no-waiters {:in (list) :out (list)})

(defn waiters-empty? (q)
  (and (empty? (get q :in)) (empty? (get q :out))))

(defn waiters-push (q w)
  (assoc q :in (cons w (get q :in))))

(defn waiters-pop (q)
  "The next waiter (FIFO) and the queue without it, as `[w q']`. Assumes a non-empty
  queue — callers gate on `waiters-empty?`."
  (let (out (get q :out))
    (if (empty? out)
      (let (flipped (reverse (get q :in)))
        [(first flipped) {:in (list) :out (rest flipped)}])
      [(first out) (assoc q :out (rest out))])))

;; ---- state helpers ----------------------------------------------------------

(defn rest-v (v) (into [] (rest v)))

(defn remove-pid (v pid)
  (into [] (filter v (fn (x) (not (= x pid))))))

(defn remove-conn (state pid)
  (assoc state
    :members (remove-pid (get state :members) pid)
    :free (remove-pid (get state :free) pid)))

(defn give-back (state pid)
  "Return `pid` to circulation: hand it to the next waiter, else mark it free. Clears the
  outgoing borrow record (demonitor) first; a re-handout to a waiter re-monitors the new
  borrower."
  (let (state (clear-borrow state pid)
        q (get state :waiters))
    (if (waiters-empty? q)
      (assoc state :free (into (get state :free) [pid]))
      (let (popped (waiters-pop q)
            w (first popped))
        (hand-out (assoc state :waiters (get popped 1)) pid (get w 0) (get w 1))))))

(defn respawn (state)
  "Open a fresh connection, monitor it, and put it into circulation. If reconnect
  fails right now (e.g. the server is down), the pool runs degraded by one until the
  next death triggers another attempt."
  (let (outcome (try {:pid (connection/start (get state :opts))} (catch e {:error e})))
    (if (get outcome :error)
      state
      (let (pid (get outcome :pid))
        (monitor pid)
        (give-back (assoc state :members (into (get state :members) [pid])) pid)))))

;; ---- client API -------------------------------------------------------------

(defn checkout (pool)
  "Block until a connection is available; return its pid."
  (let (r (ref))
    (send pool [:checkout (self) r])
    (receive ([:reply ^r pid] pid))))

(defn checkin (pool pid)
  "Return a checked-out connection to the pool."
  (send pool [:checkin pid]))

(defn with-conn (pool f)
  "Check a connection out, run `(f pid)`, and check it back in even if `f` throws."
  (let (pid (checkout pool))
    (try
      (let (result (f pid))
        (checkin pool pid)
        result)
      (catch e
        (do (checkin pool pid) (throw e))))))

;; A checked-out connection can be dead through no fault of the caller — a proxy
;; closed it while it sat in the pool (keepalive narrows but can't fully close this
;; race). Such a failure surfaces as a `:connection` store-error and the pool respawns
;; the dead member; retrying picks up a fresh one, so a transient close is invisible to
;; the caller. A genuine query error (`:query`) is NOT retried.
(def *max-attempts* 3)

(defn query (pool sql)
  "Run `sql` on a pooled connection, retrying a dead-connection failure. Returns the
  result, or throws on a genuine error."
  (with-retry pool (fn (pid) (connection/query pid sql)) *max-attempts*))

(defn exec (pool sql params)
  "Run parameterized `sql` with `params` on a pooled connection, retrying a
  dead-connection failure."
  (with-retry pool (fn (pid) (connection/exec pid sql params)) *max-attempts*))

(defn with-retry (pool f attempts)
  (let (tagged (with-conn pool (fn (pid) (f pid))))
    (cond
      (= (get tagged 0) :ok) (get tagged 1)
      (and (> attempts 1) (retryable? (get tagged 1)))
        (do
          (pause 50)
          (with-retry pool f (- attempts 1)))
      else (throw (get tagged 1)))))

(defn retryable? (err)
  "A dead/closed connection is worth retrying with a fresh one; a `:timeout` (the
  server went silent) is NOT — retrying only stacks more 15s waits and can blow the
  caller's request deadline. Fail fast instead."
  (and (connection-error? err) (not (get err :timeout))))

(defn connection-error? (err)
  (and (map? err) (= (get err :store-error) :connection)))

(defn pause (ms)
  "Sleep `ms` — a short backoff so the pool can respawn the dead member before retry."
  (receive (after ms nil)))

(defn unwrap (tagged)
  (if (= (get tagged 0) :ok)
    (get tagged 1)
    (throw (get tagged 1))))

(defn stop (pool)
  "Stop the pool and all its connections."
  (let (r (ref))
    (send pool [:stop (self) r])
    (receive ([:reply ^r v] v) (after 10000 :timeout))))

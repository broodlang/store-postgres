(defmodule conn
  "A Postgres connection: connect, authenticate, run simple queries.

  This is the spike — it runs in the caller's process (which owns the socket, so
  `[:tcp …]` chunks arrive in its mailbox). A pooled, gen-server-wrapped connection
  comes next. Backend messages are reassembled from raw chunks by `read-frame`,
  which buffers in the conn map and blocks on `receive` until a full frame is in."
  (:use hash)
  (:use crypto)
  (:use encoding)
  (:use wire/bytes)
  (:use wire/messages)
  (:alias wire/types)
  (:alias wire/scram))

;; ---- backend message types --------------------------------------------------
;; The type byte each backend message opens with. Named because `read-frame` answers the
;; raw byte: dispatching on an int is a compare, where the 1-char string it used to answer
;; cost an allocation per frame plus a walk down a chain of string comparisons.
(def +msg-auth+ 82) ; R  Authentication*
(def +msg-param+ 83) ; S  ParameterStatus
(def +msg-backend-key+ 75) ; K  BackendKeyData
(def +msg-notice+ 78) ; N  NoticeResponse
(def +msg-ready+ 90) ; Z  ReadyForQuery
(def +msg-error+ 69) ; E  ErrorResponse
(def +msg-row-desc+ 84) ; T  RowDescription
(def +msg-data-row+ 68) ; D  DataRow
(def +msg-command-done+ 67) ; C  CommandComplete
(def +msg-parse-done+ 49) ; 1  ParseComplete
(def +msg-bind-done+ 50) ; 2  BindComplete
(def +msg-close-done+ 51) ; 3  CloseComplete
(def +msg-param-desc+ 116) ; t  ParameterDescription
(def +msg-no-data+ 110) ; n  NoData
(def +msg-portal-suspended+ 115) ; s  PortalSuspended
;; ---- errors -----------------------------------------------------------------

(defn fail (kind message)
  "Throw a tagged error so callers (the pool) can classify it: `:connection`
  errors are fatal (the socket is gone — replace the connection), `:query` and
  `:auth` errors leave the connection usable / are config problems."
  (throw {:store-error kind :message (str "store: " message)}))

;; ---- sending ----------------------------------------------------------------

(defn send-message (sock message)
  "Write an assembled wire byte-string to `sock` as a first-class `bytes` value, so
  `tcp/send` emits it verbatim. Since ADR-141, `tcp/send` UTF-8-encodes a *string*
  leaf — which would re-encode every wire byte ≥ 0x80 (a message's Int32 length prefix
  once it reaches 128 bytes, or any high body byte) into two bytes and desync the
  server. See wire/bytes/iolist->bytes."
  (tcp/send sock (iolist->bytes message)))

;; ---- connect + handshake ----------------------------------------------------

(defn connect (opts)
  "Open a connection and complete startup + auth. `opts`: :host :port :user
  :password :database. Returns a conn map ready for `query`."
  (let (host (get opts :host "127.0.0.1")
        port (get opts :port 5432)
        sock (tcp/connect host port))
    (tcp/set-binary sock true)
    (send-message sock (startup-message (get opts :user) (get opts :database)))
    (handshake
      {:sock sock
       :user (get opts :user)
       :password (get opts :password)
       :buf #b""
       :off 0
       :params {}
       ;; prepared statements are per-CONNECTION server state, so the cache that
       ;; names them lives and dies with this map
       :stmts {}
       :next-stmt 0})))

(defn handshake (conn)
  "Read backend messages until ReadyForQuery ('Z'), handling auth challenges and
  recording server parameters along the way."
  (let ([type body conn] (read-frame conn))
    (cond
      (= type +msg-auth+) (handle-auth conn body)
      (= type +msg-param+) (handshake (record-param conn body))
      (= type +msg-backend-key+) (handshake conn) ; for cancellation; ignore here
      (= type +msg-notice+) (handshake conn)
      (= type +msg-ready+) conn ; handshake complete
      (= type +msg-error+) (fail :auth (error-text body))
      else (handshake conn))))

;; ---- authentication ---------------------------------------------------------

(defn handle-auth (conn body)
  "Dispatch on the Authentication sub-type (Int32 at the head of an 'R' message)."
  (let (subtype (read-int32 body 0))
    (cond
      (= subtype 0) (handshake conn) ; AuthenticationOk
      (= subtype 3) (send-password conn) ; CleartextPassword
      (= subtype 5) (send-md5 conn (bytes/slice body 4 8))
      (= subtype 10) (scram-begin conn) ; SASL — we offer SCRAM-SHA-256
      (= subtype 11) (scram-continue conn body) ; SASLContinue (server-first)
      (= subtype 12) (scram-finish conn body) ; SASLFinal (server signature)
      else (fail :auth (str "unsupported auth method " subtype)))))

(defn send-password (conn)
  (send-message (get conn :sock) (password-message (get conn :password)))
  (handshake conn))

(defn send-md5 (conn salt)
  "MD5: 'md5' ++ md5hex( md5hex(password ++ user) ++ salt-bytes ). `salt` is the 4-byte
  `bytes` slice from the AuthenticationMD5Password message."
  (let (inner (md5 (str (get conn :password) (get conn :user)))
        outer (md5-bytes (into [] (append (string/->bytes inner) (seq salt)))))
    (send-message (get conn :sock) (password-message (str "md5" outer)))
    (handshake conn)))

(defn scram-begin (conn)
  (let (nonce (gen-nonce)
        st (scram/start (get conn :user) (get conn :password) nonce))
    (send-message (get conn :sock) (sasl-initial "SCRAM-SHA-256" (get st :first)))
    (handshake (assoc conn :scram st))))

(defn scram-continue (conn body)
  (let (server-first (slice->utf8 body 4 (bytes/length body))
        st (scram/continue (get conn :scram) server-first))
    (send-message (get conn :sock) (sasl-response (get st :final)))
    (handshake (assoc conn :scram st))))

(defn scram-finish (conn body)
  (let (server-final (slice->utf8 body 4 (bytes/length body)))
    (if (= (scram/finish (get conn :scram) server-final) :ok)
      (handshake conn)
      (fail :auth "SCRAM server verification failed"))))

(defn gen-nonce ()
  "A fresh client nonce: hex of 18 random bytes (alphanumeric — no SCRAM separators)."
  (hex-encode-bytes (random-bytes 18)))

;; ---- queries ----------------------------------------------------------------

(defn query (conn sql)
  "Run `sql` via the simple query protocol (no parameters). Returns `[result conn']`
  where `result` is `{:columns [name …] :rows [[value …] …]}` with values decoded to
  Brood types and NULL → nil."
  (send-message (get conn :sock) (query-message sql))
  (let ([result conn _cols] (collect conn {:columns [] :rows (list)} []))
    [result conn]))

(defn exec (conn sql params)
  "Run `sql` with bound `params` via the extended protocol — `$1`, `$2`, … are filled
  from `params` (server-side, so values are never interpolated into SQL). Returns
  `[result conn']` like `query`.

  The statement is PREPARED on this connection the first time its text is seen and reused
  by name afterwards, so a repeated query sends three messages instead of five (no Parse,
  no Describe) and reads four frames instead of six — and Postgres skips its own parse and
  plan. An application issues a small fixed set of statements, so after warm-up nearly every
  query takes the reuse path.

  A statement the server no longer holds is not an error the caller should see: `PREPARE` is
  transactional, so a rollback discards statements prepared inside it, and DDL can
  invalidate a cached plan. Both come back as a SQLSTATE this recognises, and the answer is
  to forget every statement on this connection and Parse afresh — once. See `re-parse?`."
  (let (cached (get (get conn :stmts) sql))
    (if (nil? cached)
      (exec-fresh conn sql params)
      (try
        (exec-prepared conn cached params)
        (catch e
          (if (re-parse? e)
            (exec-fresh (assoc (get e :conn) :stmts {}) sql params)
            (throw e)))))))

;; How many prepared statements one connection will hold. An application's set of statements
;; is small and fixed, so this is never reached in normal use; it is the backstop against SQL
;; built by string interpolation, where every call is a new statement and an unbounded cache
;; would grow the server's memory as well as ours. Past the cap `exec` keeps working on the
;; unnamed-statement path, which is exactly what it did before any of this.
(def *max-statements* 64)

(defn re-parse? (e)
  "Whether error `e` means *this connection must Parse this statement again*, rather than
  the query being wrong.

  `26000` invalid_sql_statement_name — the server does not have it: prepared inside a
  transaction that rolled back, or a pooler reset the session. `0A000` is what Postgres
  raises for `cached plan must not change result type`, after DDL changes a table the
  statement reads. Anything else is the caller's problem and is re-thrown."
  (and (= (get e :store-error) :query)
    (includes? ["26000" "0A000"] (get e :code))))

(defn exec-prepared (conn cached params)
  "Bind and execute an already-prepared statement: no Parse, no Describe. The column
  descriptors come from the cache because the server sends RowDescription only when asked,
  and asking is one of the two messages this path exists to avoid."
  (send-message (get conn :sock)
    [(bind-message "" (get cached :name) params) (execute-message "" 0) (sync-message)])
  (let ([result conn _cols] (collect conn {:columns [] :rows (list)} (get cached :cols)))
    [result conn]))

(defn exec-fresh (conn sql params)
  "Parse `sql` as a named statement, describe it to learn its result columns, then bind and
  execute — and remember the name and columns for next time.

  `Describe(S)` and not `Describe(P)`: describing the STATEMENT is what yields descriptors
  valid for every later execution, where describing the portal would only describe this one.
  Past `*max-statements*` nothing is named or remembered and this is the original one-shot
  unnamed-statement exchange."
  (let (cache (get conn :stmts)
        room? (< (count cache) *max-statements*)
        n (get conn :next-stmt 0)
        name (if room? (str "s" n) ""))
    (send-message (get conn :sock)
      [(parse-message name sql)
        (describe-message "S" name)
        (bind-message "" name params)
        (execute-message "" 0)
        (sync-message)])
    (let ([result conn cols] (collect conn {:columns [] :rows (list)} []))
      [result
        (if room?
          (assoc conn :stmts (assoc cache sql {:name name :cols cols}) :next-stmt (+ n 1))
          conn)])))

(defn collect (conn acc cols)
  "Drive the result stream until ReadyForQuery. Returns `[result conn' cols]`.

  `cols` is the current column descriptor list (`[{:name :type-oid} …]`) — passed IN so a
  prepared statement can supply the descriptors it learned at Parse time (the server sends
  RowDescription only when asked), and passed back OUT so that first execution can cache
  them. `result` carries only the column NAMES, which is what a caller wants and not enough
  to decode a later row."
  (let ([type body conn] (read-frame conn))
    ;; Ordered by how often a result stream actually carries each frame: a DataRow per row,
    ;; then the three that close every query. The rest are one-offs or acknowledgements and
    ;; fall through to the shared `else`, which continues exactly as they each did.
    (cond
      (= type +msg-data-row+) (collect conn (add-row acc cols body) cols)
      (= type +msg-ready+) [(finalize acc cols) conn cols] ; done
      (= type +msg-row-desc+) (collect conn acc (parse-row-description body))
      (= type +msg-command-done+) (collect conn acc cols)
      (= type +msg-error+) (collect-error conn body cols)
      ;; ParseComplete / BindComplete / CloseComplete / ParameterDescription / NoData /
      ;; PortalSuspended / NoticeResponse / a mid-stream ParameterStatus — nothing to record,
      ;; keep reading. An unknown type is skipped for the same reason: the stream is still
      ;; framed correctly, and ReadyForQuery ends it.
      else (collect conn acc cols))))

(defn collect-error (conn body cols)
  "An ErrorResponse mid-query: the server still sends ReadyForQuery after it, so
  drain to that first — then the connection stays usable. The drained conn rides on
  the thrown error so a caught caller (the pool) can keep serving on it, and the SQLSTATE
  rides with it so `exec` can tell a statement this connection must re-Parse from a query
  that is simply wrong."
  (let (fields (error-fields body 0 {})
        conn (drain-to-ready conn))
    (throw {:store-error :query
            :message (str "store: " (error-message fields))
            :code (get fields "C")
            :conn conn})))

(defn drain-to-ready (conn)
  (let ([type _body conn] (read-frame conn))
    (if (= type +msg-ready+) conn (drain-to-ready conn))))

(defn finalize (acc cols)
  "Project the column descriptors down to names and restore row order. Rows were
  accumulated head-first (`add-row` conses — O(1) — rather than appending to a
  fixed-length vector, which copies), so reverse once here into the public vector."
  (assoc acc
    :columns (into [] (map cols (fn (c) (get c :name))))
    :rows (into [] (reverse (get acc :rows)))))

(defn add-row (acc cols body)
  (assoc acc :rows (cons (decode-row body cols) (get acc :rows))))

;; ---- frame reassembly -------------------------------------------------------

(defn buffered (conn)
  "Unconsumed byte count in the conn's buffer (bytes from `:off` to the end)."
  (- (bytes/length (get conn :buf)) (get conn :off)))

(defn read-frame (conn)
  "Pull one complete backend message. Returns `[type body conn']` where `type` is
  the message-type BYTE (see the `+msg-*+` constants), `body` the message body (a `bytes`
  slice, length field stripped), and `conn'` the conn with its read offset advanced past
  the consumed frame.

  The type is an int and not a 1-char string because every caller DISPATCHES on it: a
  string cost an allocation per frame and then a chain of up to thirteen string
  comparisons, and a trivial query is six frames.
  The buffer is a `bytes` value read in place: advancing a plain `:off` (rather than
  re-slicing the tail each frame) keeps decoding a large result O(rows) not O(rows²)."
  (let (conn (fill-to conn 5)
        buf (get conn :buf)
        off (get conn :off)
        type (bytes/at buf off)
        total (+ 1 (read-int32 buf (+ off 1)))
        conn (fill-to conn total)
        ;; fill-to may have compacted the buffer, resetting :off — re-read both
        buf (get conn :buf)
        off (get conn :off))
    [type
      (bytes/slice buf (+ off 5) (+ off total))
      (assoc conn :off (+ off total))]))

(defn fill-to (conn n)
  "Ensure at least `n` unconsumed bytes are buffered, blocking on the mailbox for more
  socket chunks as needed. The buffer is the `bytes` value `[:tcp …]` delivers, appended
  verbatim (no Latin-1 carrier copy). Compacts as it appends — the already-consumed prefix
  (up to `:off`) is dropped, so the append copies only the small unconsumed remainder plus
  the new chunk, never the frames we've already moved past."
  (if (>= (buffered conn) n)
    conn
    (let (sock (get conn :sock)
          more (receive
                 ([:tcp ^sock d] d)
                 ([:tcp-closed ^sock] (fail :connection "connection closed by server"))
                 ;; A server that went silent — flag it `:timeout` so the pool does NOT
                 ;; retry it (retrying only stacks more 15s waits); a closed socket above
                 ;; is the retryable case.
                 (after 15000
                   (throw {:store-error :connection
                           :timeout true
                           :message "store: timed out waiting for server"})))
          buf (get conn :buf)
          kept (bytes/slice buf (get conn :off) (bytes/length buf)))
      (fill-to (assoc conn :buf (bytes/concat kept more) :off 0) n))))

;; ---- backend message decoders -----------------------------------------------

(defn record-param (conn body)
  "ParameterStatus ('S'): name CString, value CString → record in conn :params."
  (let ([name after-name] (read-cstring body 0)
        [value _end] (read-cstring body after-name))
    (assoc conn :params (assoc (get conn :params) name value))))

(defn parse-row-description (body)
  "RowDescription ('T'): Int16 field count, then per field a name CString followed by
  18 bytes of metadata. We keep the name and the type OID (at offset name-end + 6),
  returning `[{:name :type-oid} …]`. Fields are consed head-first then reversed once, so
  the scan is O(fields) rather than O(fields²)."
  (into [] (reverse (rd-fields body 2 (read-int16 body 0) (list)))))

(defn rd-fields (body off n acc)
  (if (= n 0)
    acc
    ;; Destructured, not `get`-indexed: a tuple pattern tells the checker each element's
    ;; type, where `(get r 1)` widens to `nil | int | string` and every arithmetic use of
    ;; the offset downstream then reads as possibly-not-an-int.
    (let ([name name-end] (read-cstring body off))
      (rd-fields body
        (+ name-end 18)
        (- n 1)
        (cons {:name name :type-oid (read-int32 body (+ name-end 6))} acc)))))

(defn decode-row (body cols)
  "DataRow ('D'): Int16 column count, then per column an Int32 length (-1 = NULL) and
  that many text bytes — decoded to a Brood value via the column's type OID. Columns are
  consed head-first then reversed once into the row vector, so a wide row is O(cols)."
  (into [] (reverse (dr-cols body 2 (read-int16 body 0) cols 0 (list)))))

(defn dr-cols (body off n cols idx acc)
  (if (= idx n)
    acc
    (let (len (read-int32 body off))
      (if (= len 4294967295)
        ; -1 as unsigned → NULL
        (dr-cols body (+ off 4) n cols (+ idx 1) (cons nil acc))
        (let (oid (get (get cols idx) :type-oid)
              text (slice->utf8 body (+ off 4) (+ off 4 len)))
          (dr-cols body
            (+ off 4 len)
            n
            cols
            (+ idx 1)
            (cons (types/decode-value oid text) acc)))))))

(defn error-text (body)
  "ErrorResponse ('E'): a series of (type byte, value CString) ended by a zero byte.
  Render the severity, message, and SQLSTATE."
  (error-message (error-fields body 0 {})))

(defn error-message (fields)
  "Render already-parsed ErrorResponse `fields` as one line."
  (str (get fields "S" "ERROR")
    ": "
    (get fields "M" "(no message)")
    (if (get fields "C") (str " [" (get fields "C") "]") "")))

(defn error-fields (body off acc)
  (if (= (bytes/at body off) 0)
    acc
    (let (code (byte->char (bytes/at body off))
          [text next-off] (read-cstring body (+ off 1)))
      (error-fields body next-off (assoc acc code text)))))
(sig error-fields (bytes int map -> map))

;; ---- teardown ---------------------------------------------------------------

(defn close (conn)
  "Send Terminate and close the socket."
  (send-message (get conn :sock) (terminate-message))
  (tcp/close (get conn :sock)))

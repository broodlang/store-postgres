(defmodule wire/bytes
  "Byte-level toolkit for the Postgres wire protocol.

  Wire data appears in a few representations, converted only at the seams:

    - an *iolist*      — the OUTBOUND assembly form (ADR-139): a string (UTF-8), a `bytes`
                         value, a byte int 0–255, or any nesting of those. Nothing is
                         copied while a message is being built; `iolist->bytes` flattens
                         the finished message once, in the kernel, for `tcp/send`;
    - a *`bytes` value* — what binary-mode `[:tcp …]` delivers and what the INBOUND reader
                         works over directly (`octet-at`/`subbytes`/`byte-length`) — no
                         Latin-1 carrier copy, so a large result isn't re-materialised as a
                         codepoint string;
    - a *byte vector*  — a vector of ints 0–255, what `crypto`/`hash` operate on.

  Outbound assembly used to build a *byte string* — one Brood codepoint per byte — which
  meant per-byte interpreted work for every integer, CString and parameter, and then a
  second whole-message pass to convert the carrier back to `bytes`. A `bytea` parameter
  paid it worst: a tarball was expanded to one codepoint per byte through `apply str` and
  then collapsed again. The iolist hands the same `bytes` value straight to the kernel.

  Crypto/encoding now live in the stdlib's raw-byte layer (`hash/*-raw`,
  `crypto/pbkdf2` over byte vectors, `encoding/base64-*-bytes` / `hex-*-bytes`);
  this module is just the wire-format glue — the carrier, fixed-width ints, and
  CStrings.")

;; ---- byte <-> codepoint -----------------------------------------------------

;; Position n holds the 1-char string for byte value n (all 256). \xHH is one byte.
(def *byte-table*
  (str "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
    "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"
    "\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f"
    "\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f"
    "\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f"
    "\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f"
    "\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f"
    "\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f"
    "\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f"
    "\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f"
    "\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf"
    "\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf"
    "\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf"
    "\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf"
    "\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef"
    "\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"))

(defn byte->char (n)
  "Byte value 0–255 → its 1-char byte string."
  (string/char-at *byte-table* n))

(defn octet-at (b i)
  "Byte value 0–255 at index `i` of `bytes` value `b`. The readers below run over the
  inbound buffer through this."
  ;; `bytes/at`, not `get`: both index a `bytes` in O(1), but `get` is the generic collection
  ;; accessor and dispatches on the collection kind every call — measured 1.40us against
  ;; `bytes/at`'s 0.31us, and this is called per byte by every reader below.
  (bytes/at b i))

(defn slice->utf8 (b start end)
  "Decode the UTF-8 bytes in `b[start:end]` to text. The inbound path never rebuilds the
  whole stream as a string; it slices straight out of the `bytes` buffer."
  (string/bytes-> (bytes/slice b start end)))

(defn utf8-bytes (s)
  "UTF-8-encode text `s` to a `bytes` value. A thin name over `string/->bytes`, kept because
  the SASL messages need the ENCODED LENGTH of a string before they can frame it, and asking
  for that is clearer than encoding it twice."
  (string/->bytes s))

(defn iolist->bytes (io)
  "Flatten a finished outbound message to one `bytes` value for `tcp/send`.

  One kernel call over the whole tree, so a message is copied exactly once however deeply
  it was nested while being built. `tcp/send` must be handed `bytes` and not a string:
  since ADR-141 it UTF-8-encodes a string leaf, which would re-encode every byte ≥ 0x80
  into two wire bytes and corrupt any length prefix."
  (bytes/concat io))

;; ---- fixed-width big-endian integers ----------------------------------------

(defn int32-be (n)
  "`n` → a 4-byte big-endian `bytes` value (Postgres Int32).

  `bytes/int->` is two's complement, which is what the protocol wants both ways: a length
  is non-negative and encodes identically, and the -1 that marks a SQL NULL parameter is
  `(int32-be -1)` → `FF FF FF FF`, read back by `read-int32` as 4294967295."
  (bytes/int-> n 4))

(defn int16-be (n)
  "`n` → a 2-byte big-endian `bytes` value (Postgres Int16)."
  (bytes/int-> n 2))

(defn read-int32 (s off)
  "Read an unsigned 32-bit big-endian int at byte offset `off` of `bytes` value `s`.

  One native `bytes/uint`, which reads an n-byte big-endian unsigned integer directly. This
  is the single hottest reader in the driver — once per column plus once per frame, so a
  thousand-row result calls it thousands of times — and the hand-rolled form was four
  generic `get`s plus three multiplies and three adds: 4.65us against `bytes/uint`'s
  1.23us, for the same value."
  (bytes/uint s off 4))

(defn read-int16 (s off)
  "Read an unsigned 16-bit big-endian int at byte offset `off` of `bytes` value `s`.
  `bytes/uint` for the same reason as `read-int32`'s."
  (bytes/uint s off 2))

;; ---- C strings (NUL-terminated) ---------------------------------------------

(defn cstring (text)
  "Text → a NUL-terminated CString, as an IOLIST — `bytes/concat` UTF-8-encodes the string
  itself, so nothing here walks it."
  [text 0])

(defn read-cstring (s off)
  "Read a NUL-terminated string starting at `off`. Returns `[text next-off]` where
  `next-off` is just past the NUL."
  (read-cstring-scan s off off))

(defn- read-cstring-scan (s start i)
  (if (= (octet-at s i) 0)
    [(slice->utf8 s start i) (+ i 1)]
    (read-cstring-scan s start (+ i 1))))

;; ---- byte-vector XOR (SCRAM's client proof; no stdlib equivalent) -----------

(defn xor-bytes (a b)
  "XOR two equal-length byte vectors → byte vector."
  (into [] (map (range (count a)) (fn (i) (bit/xor (get a i) (get b i))))))

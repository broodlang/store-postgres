(defmodule wire/types
  "Type codecs: map Postgres values (text format) to/from Brood values, keyed by the
  column's type OID. We request *text*-format results and send *text*-format params,
  so every type round-trips through its textual form — universal, and enough to give
  callers real Brood values (ints, floats, bools, byte vectors) instead of strings.

  Binary format (faster, exact for float/numeric) is a later refinement; the OID
  table here is the seam it will plug into."
  (:use wire/bytes)
  (:use encoding))

;; ---- type OIDs (from pg_type) ----------------------------------------------

(def *oid-bool* 16)
(def *oid-bytea* 17)
(def *oid-int8* 20)
(def *oid-int2* 21)
(def *oid-int4* 23)
(def *oid-oid* 26)
(def *oid-float4* 700)
(def *oid-float8* 701)
(def *oid-numeric* 1700)

(def *int-oids* [*oid-int8* *oid-int2* *oid-int4* *oid-oid*])
(def *float-oids* [*oid-float4* *oid-float8*])

;; ---- decode: server text -> Brood value -------------------------------------

(defn decode-value (oid text)
  "Decode a text-format column value (already a Brood string) to a Brood value,
  using its type OID. NULL is handled by the caller (passed as nil)."
  (cond
    (nil? text) nil
    (= oid *oid-bool*) (= text "t")
    (includes? *int-oids* oid) (string->number text)
    (includes? *float-oids* oid) (string->number text)
    (= oid *oid-bytea*) (bytea->bytes text)
    ;; numeric decodes to an exact Brood decimal — full precision (a float would
    ;; lose it). text/varchar/uuid/json/timestamp/date/time pass through as strings.
    (= oid *oid-numeric*) (decimal text)
    else text))

(defn bytea->bytes (text)
  "Postgres bytea text format is `\\x` + hex; decode to a byte vector."
  (hex-decode-bytes (substring text 2 (string-length text))))

;; ---- encode: Brood value -> wire param --------------------------------------

(defn encode-param (value)
  "Encode one bound parameter as a Bind wire fragment: Int32 length + value bytes, or
  Int32 -1 for SQL NULL. A `bytes` value is sent in BINARY format (its raw bytes, paired
  with a format code of 1 in `bind-message`) — so a large `bytea` (a tarball) rides as its
  own bytes with no `\\x`-hex doubling or per-parameter text re-encoding. Everything else is
  text format, and the server casts per the column type it inferred at Parse."
  (cond
    (nil? value) (int32-be 4294967295) ; length -1 → SQL NULL
    (bytes? value) (str (int32-be (byte-length value)) (bytes->bytestr value))
    else (let (encoded (utf8-bytestr (param->text value)))
           (str (int32-be (string-length encoded)) encoded))))

(defn param-format-code (value)
  "The Bind parameter format code for `value`: 1 (binary) for a `bytes` value, else 0
  (text). Paired 1:1 with the params so the server reads each in the right format."
  (if (bytes? value) (int16-be 1) (int16-be 0)))

(defn param->text (value)
  "Brood value → its Postgres text-format literal."
  (cond
    (= value true) "t"
    (= value false) "f"
    (string? value) value
    (int? value) (number->string value)
    (float? value) (number->string value)
    ;; a decimal renders as plain numeric text (no `M`) — what Postgres numeric accepts
    (decimal? value) (decimal->string value)
    else (str value)))
